<!-- views/customers.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Customers</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>Customers</h1>
    <form method="GET" action="/customers">
        <input type="text" name="search" placeholder="Search by name, email, UID">
        <select name="platform">
            <option value="">All Platforms</option>
            <option value="watchlist-pro">Watchlist Pro</option>
            <option value="my-family-cinema">My Family Cinema</option>
        </select>
        <button type="submit">Search</button>
    </form>

    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Package</th>
                <th>Payment Status</th>
                <th>Cloud</th>
                <th>Source</th>
            </tr>
        </thead>
        <tbody>
            <% customers.forEach(customer => { %>
                <tr>
                    <td><%= customer.fullName %></td>
                    <td><%= customer.email %></td>
                    <td><%= customer.package %></td>
                    <td><%= customer.paymentStatus === 'paid' ? '🟢' : '🔴' %></td>
                    <td>
                        <form method="POST" action="/customers/toggle-cloud/<%= customer._id %>">
                            <input type="checkbox" name="cloud" <%= customer.cloud ? 'checked' : '' %> onchange="this.form.submit()">
                        </form>
                    </td>
                    <td><%= customer.source %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <h2>Add User Manually</h2>
    <form method="POST" action="/customers/add">
        <input type="text" name="fullName" placeholder="Full Name" required>
        <input type="email" name="email" placeholder="Email" required>
        <input type="text" name="whatsappNumber" placeholder="Whatsapp" required>
        <input type="text" name="uids" placeholder="UID" required>
        <input type="text" name="accounts" placeholder="Account" required>
        <select name="package">
            <option value="mfc-premium-780">MFC Premium</option>
            <option value="mfc-standard-420">MFC Standard</option>
            <!-- Add more package options -->
        </select>
        <button type="submit">Add User</button>
    </form>
</body>
</html>
